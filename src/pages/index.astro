---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main class="linktree">
			<h1>{SITE_TITLE}</h1>
			<p class="tagline">Practical experience. <em>Direct</em> advice.</p>
			<figure class="video-feature">
				<div class="video-embed">
					<iframe
						src="https://www.youtube-nocookie.com/embed/a6Wgp-cEmOo"
						title="Portraits of NSF NCAR: Chris Zavala"
						loading="lazy"
						frameborder="0"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					></iframe>
				</div>
				<figcaption>
					<strong>Portraits of NSF NCAR</strong> — a series highlighting the people behind the
					science at the National Center for Atmospheric Research, sharing the personal journeys,
					passions, and experiences that drive those working in the Earth system sciences. This
					episode features me as a systems administrator who configures computer systems to
					enable atmospheric science research.
				</figcaption>
			</figure>
			<p>
				I'm Chris Zavala — an IT professional based in Colorado with over a decade of hands-on
				experience across infrastructure, workplace technology, and organizational IT strategy.
				I've worked inside organizations ranging from lean 10-person SMBs to enterprise
				environments with 1,200+ employees, which means I understand both the budget constraints
				and the political realities.
			</p>
			<p>
				My background is practical, not theoretical. I've built and maintained the infrastructure,
				argued for the tooling budget, and managed the conversation with leadership when the
				technology isn't working the way anyone promised it would. Read more on the <a
					href="https://zavalatechconsulting.com/#about">consulting site</a
				>.
			</p>
			<ul>
				{
					LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<style>
			.linktree {
				max-width: 560px;
				margin: 10vh auto 0;
				padding: 1em;
				text-align: center;
			}
			.linktree h1 {
				margin-bottom: 0.25em;
			}
			.linktree .tagline {
				color: rgb(var(--gray));
				margin-bottom: 1.5em;
			}
			.video-feature {
				margin: 0 0 1.5em;
			}
			.video-embed {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				border-radius: 12px;
				overflow: hidden;
				background: rgb(var(--gray-light));
			}
			.video-embed iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}
			.video-feature figcaption {
				margin-top: 0.75em;
				text-align: left;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.linktree p {
				text-align: left;
			}
			.linktree ul {
				list-style: none;
				margin: 1.5em 0 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.linktree a {
				display: block;
				padding: 0.9em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				color: rgb(var(--black));
				text-decoration: none;
				font-weight: 600;
				transition: 0.2s ease;
			}
			.linktree a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
		</style>
	</body>
</html>
