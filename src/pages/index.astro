---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main class="linktree">
			<h1>{SITE_TITLE}</h1>
			<ul>
				{
					LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<style>
			.linktree {
				max-width: 480px;
				margin: 10vh auto 0;
				padding: 1em;
				text-align: center;
			}
			.linktree h1 {
				margin-bottom: 1.5em;
			}
			.linktree ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.linktree a {
				display: block;
				padding: 0.9em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				color: rgb(var(--black));
				text-decoration: none;
				font-weight: 600;
				transition: 0.2s ease;
			}
			.linktree a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
		</style>
	</body>
</html>
